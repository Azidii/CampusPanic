# Copy to .env locally. Generate independent secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mainDB
CLIENT_URL=http://localhost:5000
JWT_SECRET=
DEVICE_API_KEY=
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.invalid
ADMIN_NAME=Campus security administrator
# Optional local model paths. Keep workers bound to loopback.
VIDEO_PYTHON=
VIDEO_MODEL_PATH=
AUDIO_PYTHON=
AUDIO_MODEL_PATH=
