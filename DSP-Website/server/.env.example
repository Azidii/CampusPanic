# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# If MongoDB is not running locally, the server will automatically fall back to an in-memory MongoDB instance
MONGODB_URI=mongodb://127.0.0.1:27017/campuspanic

# Authentication Secrets
JWT_SECRET=campuspanic_jwt_secure_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Device Ingestion Security
# ESP32 and Python gateways must pass this key in the 'x-device-api-key' header
DEVICE_API_KEY=campuspanic_device_ingest_key_secure_2025

# Privacy & Data Retention (Data Privacy Act Compliance)
# Hours before raw alert images are purged from disk (0 = disabled)
IMAGE_RETENTION_HOURS=24

# Initial Admin Seed Credentials
ADMIN_NAME=Chief of Campus Security
ADMIN_EMAIL=admin@campuspanic.edu
ADMIN_PASSWORD=Admin123!
ADMIN_BUILDING=Security HQ
