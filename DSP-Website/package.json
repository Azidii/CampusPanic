{
  "name": "campuspanic-website",
  "version": "1.0.0",
  "description": "CampusPanic Emergency Alert System - Unified Express + EJS Security Console",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:check": "node scripts/check-db.js",
    "seed": "node scripts/seed.js",
    "simulate": "node scripts/simulate-alert.js",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "test:audio": "node --test tests/audio-streaming.test.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.8",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3"
  }
}
