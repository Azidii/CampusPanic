<%- include('partials/head') %>

<div class="app-container">
  <%- include('partials/sidebar') %>

  <div class="main-content">
    <%- include('partials/navbar') %>

    <main class="page-body" tabindex="-1" id="mainContent" tabindex="-1">
      <div style="margin-bottom: 24px;">
        <h1>Settings</h1>
        <p style="font-size: 0.85rem; color: var(--text-secondary);">Choose your display, alarm sound and data retention preferences.</p>
      </div>

      <div class="settings-grid">
        <!-- Visual & Display Settings -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Display</h2>
          </div>
          <div class="settings-group">
            <div class="setting-row" style="flex-direction: column; align-items: flex-start; gap: 8px;">
              <div class="setting-info">
                <div class="setting-title">Theme</div>
                <div class="setting-desc">Your choice applies to every page.</div>
              </div>

              <div class="theme-picker-group" style="width: 100%;">
                <button type="button" class="theme-card" data-theme-val="dark">
                  <div class="theme-preview-box preview-dark"></div>
                  <div class="theme-name">Dark</div></button>
                <button type="button" class="theme-card" data-theme-val="light">
                  <div class="theme-preview-box preview-light"></div>
                  <div class="theme-name">Light</div></button>
              </div>
            </div>
          </div>
        </div>

        <!-- Audio Siren & Notifications -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Alarm sound</h2>
          </div>
          <div class="settings-group">
            <div class="setting-row">
              <div class="setting-info">
                <label class="setting-title" for="soundToggleInput">Verified Threat Audio Siren</label>
                <div class="setting-desc">Play acoustic two-tone siren when computer vision verifies an emergency</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="soundToggleInput" checked>
                <span class="slider"></span>
              </label>
            </div>

            <div class="setting-row" style="flex-direction: column; align-items: flex-start; gap: 10px;">
              <div style="display: flex; justify-content: space-between; width: 100%;">
                <label class="setting-title" for="volumeSlider">Alarm Siren Volume</label>
                <span id="volumeValText" style="font-family: var(--font-mono); font-weight: 700; color: var(--accent);">80%</span>
              </div>
              <input type="range" id="volumeSlider" min="0" max="1" step="0.05" value="0.8" style="width: 100%; accent-color: var(--accent);">
            </div>

            <div style="margin-top: 10px;">
              <button id="testAlarmSoundBtn" class="btn btn-warning" style="width: 100%;">
                Test Emergency Alarm Siren
              </button>
            </div>
          </div>
        </div>

        <!-- Privacy & Compliance -->
        <div class="card" style="grid-column: 1 / -1;">
          <div class="card-header">
            <h2 class="card-title">Data Privacy &amp; Retention Compliance</h2>
          </div>
          <div style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.6;">
            <p style="margin-bottom: 10px;">
              In compliance with the <strong>Data Privacy Act</strong>, CampusPanic does not conduct continuous video surveillance storage. Only incident-triggered camera frames are persisted to disk upon verified alert events.
            </p>
            <div style="display: flex; gap: 20px; flex-wrap: wrap; margin-top: 14px;">
              <div style="background-color: var(--bg-surface); padding: 12px 16px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle);">
                <div style="font-size:0.8125rem; color: var(--text-muted); text-transform:none;">Image Retention Threshold</div>
                <div style="font-size: 1.1rem; font-weight: 700; color: var(--text-primary);">24 Hours (Configurable)</div>
              </div>
              <div style="background-color: var(--bg-surface); padding: 12px 16px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle);">
                <div style="font-size:0.8125rem; color: var(--text-muted); text-transform:none;">Automated Purge Frequency</div>
                <div style="font-size: 1.1rem; font-weight: 700; color: var(--status-online);">Hourly Sweep Active</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <% if (user.role === 'admin') { %>
      <section class="card alert-reset-section" aria-labelledby="alertResetTitle">
        <h2 id="alertResetTitle">Alert maintenance</h2>
        <p>Permanently delete all shared alerts and their incident snapshots. Users, devices, pairings and configuration are preserved. Continuing detections may generate new alerts after the reset.</p>
        <button class="btn btn-outline" id="reviewAlertReset">Delete all alerts</button>
        <p id="alertResetResult" role="status"></p>
      </section>
      <dialog id="alertResetDialog" class="alert-reset-dialog" aria-labelledby="alertResetDialogTitle">
        <form id="alertResetForm">
          <h2 id="alertResetDialogTitle">Delete all alerts permanently?</h2>
          <p id="alertResetCount"></p>
          <p>This affects every operator. Incident snapshots are deleted too. Continuing detections may generate new alerts.</p>
          <label for="alertResetConfirmation">Type DELETE ALL ALERTS to confirm</label>
          <input class="form-input" id="alertResetConfirmation" required autocomplete="off" pattern="DELETE ALL ALERTS">
          <div class="feed-actions"><button class="btn btn-outline" type="button" id="cancelAlertReset">Cancel</button><button class="btn btn-danger" type="submit" id="confirmAlertReset">Delete permanently</button></div>
          <p id="alertResetError" role="alert"></p>
        </form>
      </dialog>
      <% } %>
    </main>

    <%- include('partials/footer') %>
  </div>
</div>

<%- include('partials/scripts') %>
