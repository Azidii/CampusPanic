<dialog id="nodeDialog" class="node-dialog" aria-labelledby="nodeDialogTitle">
  <div class="node-dialog-heading">
    <div>
      <p class="nodes-eyebrow">SECURITY NODE // ENLARGED TELEMETRY</p>
      <h2 id="nodeDialogTitle">Live Video Feed</h2>
      <p id="nodeDialogLocation" class="nodes-hint"></p>
    </div>
    <button class="btn btn-outline modal-close-btn" type="button" id="closeNodeDialog" aria-label="Close enlarged node view">&times;</button>
  </div>

  <div class="node-dialog-layout">
    <section>
      <div class="node-viewport node-enlarged" id="dialogPreview">
        <img hidden alt="Enlarged live security video">
        <div class="viewport-reticle" aria-hidden="true"></div>
        <div class="viewport-signal-tag font-mono">SIGNAL: OFFLINE // NO FEED</div>
        <div class="node-idle">
          <span class="camera-symbol">◉</span>
          <strong>Camera is currently inactive</strong>
          <span>Connect the phone to inspect live model computer vision inferences.</span>
        </div>
        <span class="node-muted">🔇 AUDIO NOT CONFIGURED</span>
      </div>

      <dl id="nodeLiveDetails" class="node-live-details"></dl>

      <section class="node-audio-controls" aria-labelledby="esp32Heading">
        <div class="node-audio-heading">
          <h3 id="esp32Heading">Audio · ESP32</h3>
          <span id="esp32AudioState" role="status">Not connected</span>
        </div>
        <p id="esp32DeviceStatus" class="nodes-hint"></p>
        <p class="nodes-hint">The Elechouse V3 sends voice-command data. Raw audio for CNN detection requires a separate microphone.</p>
        <% if (user.role === 'admin') { %>
          <div class="node-action-row">
            <button class="btn btn-outline" id="scanEsp32Btn" type="button">Scan available ESP32s</button>
            <button class="btn btn-outline" id="muteEsp32Btn" type="button" aria-pressed="false" disabled>Mute audio</button>
            <button class="btn btn-outline" id="disconnectEsp32Btn" type="button" disabled>Disconnect ESP32</button>
          </div>
          <form id="esp32PairForm" class="node-form" autocomplete="off" hidden>
            <label for="esp32Device">Available ESP32</label>
            <select id="esp32Device" required><option value="">Scan to find a device</option></select>
            <label for="esp32Pin">PIN shown on the ESP32</label>
            <input type="text" id="esp32Pin" inputmode="numeric" pattern="[0-9]{8}" maxlength="8" minlength="8" autocomplete="one-time-code" placeholder="8-digit PIN" required>
            <button class="btn btn-primary" type="submit">Pair ESP32 to this node</button>
          </form>
        <% } %>
        <p id="esp32PairMessage" class="nodes-hint" role="status" aria-live="polite"></p>
        <p class="nodes-hint">Mute affects audio monitoring only. Manual buttons and smoke detection remain active.</p>
      </section>
    </section>

    <section class="node-dialog-controls">
      <% if (user.role === 'admin') { %>
        <h3>Edit Node Parameters</h3>
        <form id="editNodeForm" class="node-form" autocomplete="off">
          <%- include('node-fields', { prefix: 'edit' }) %>
          <button class="btn btn-primary" type="submit">Save Changes</button>
        </form>

        <div class="node-connection-controls">
          <h3>Connection Setup &amp; Token</h3>
          <p class="nodes-hint">Generating a new code revokes previous sessions. Input the fresh token in Campus Panic Camera.</p>
          <div class="node-action-row">
            <button class="btn btn-outline" id="pairNodeBtn" type="button">Reconnect / Pair Again</button>
            <button class="btn btn-outline" id="disconnectNodeBtn" type="button">Disconnect</button>
          </div>
          <div id="pairingPanel" class="pairing-panel" hidden>
            <label>Phone App Pairing Code</label>
            <output id="pairingCode"></output>
            <span id="pairingExpiry"></span>
            <label>Target LAN Host IPv4 Address</label>
            <div id="pairingAddresses"></div>
            <p>Ensure phone and laptop operate on the same Wi-Fi subnet. Launch Campus Panic Camera, enter target IPv4:5000 and the 8-digit code.</p>
          </div>
        </div>

        <button class="btn btn-danger" id="deleteNodeBtn" type="button">Delete Node</button>
      <% } else { %>
        <p class="nodes-hint">Node modifications and pairing lifecycle controls are restricted to administrators.</p>
      <% } %>

      <p id="nodeActionMessage" role="status" class="nodes-hint"></p>
    </section>
  </div>
</dialog>
