<header class="top-nav">
  <div class="nav-left">
    <button class="nav-mobile-toggle" id="mobileNavToggle" aria-label="Toggle navigation menu">&#9776;</button>

    <!-- Contextual SOC Telemetry & Breadcrumb -->
    <div class="soc-breadcrumbs" aria-label="Current security sector">
      <span class="soc-category">
        <% if (page === 'security-nodes') { %>GATEWAY TOOLS
        <% } else if (page === 'dashboard' || page === 'cam-view' || page === 'all-cams') { %>OPERATIONS CONSOLE
        <% } else if (page === 'map-view' || page === 'active-nodes-map') { %>CAMPUS GEOMETRY
        <% } else if (page === 'admin-users') { %>ADMINISTRATION
        <% } else { %>SYSTEM &amp; ACCOUNT<% } %>
      </span>
      <span class="soc-separator">/</span>
      <span class="soc-current-page">
        <% if (page === 'security-nodes') { %>SECURITY NODES
        <% } else if (page === 'dashboard') { %>DASHBOARD
        <% } else if (page === 'cam-view') { %>CAM VIEW
        <% } else if (page === 'all-cams') { %>ALL CAMS (CCTV)
        <% } else if (page === 'map-view') { %>CAMPUS MAP
        <% } else if (page === 'active-nodes-map') { %>ACTIVE THREATS MAP
        <% } else if (page === 'admin-users') { %>USER MANAGEMENT
        <% } else if (page === 'profile') { %>PROFILE
        <% } else if (page === 'settings') { %>SETTINGS
        <% } else { %>OPERATIONS<% } %>
      </span>
    </div>

    <div class="system-status-indicator">
      <span class="pulse-ring-container">
        <span class="pulse-ring-ping"></span>
        <span class="pulse-ring-core"></span>
      </span>
      <span class="status-indicator-text">SOC LIVE</span>
    </div>
  </div>

  <div class="nav-right">
    <!-- Live Tactical Monospace Clock Pod with LOCAL Micro-label -->
    <div class="soc-live-clock-pod" title="SOC Tactical Reference Clock">
      <span class="soc-clock-label">LOCAL</span>
      <span class="soc-live-clock font-mono" id="liveClock">--:--:--</span>
    </div>

    <!-- Hardware-Style Audio Siren Toggle -->
    <button class="hardware-siren-btn" id="quickAlarmToggleBtn" title="Test Audio Siren Relay" onclick="if(window.alarmSound) window.alarmSound.playAlarm(2000);">
      <span class="siren-led-dot"></span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
      </svg>
      <span class="siren-btn-text">SIREN</span>
      <span class="siren-state-pill">ARMED</span>
    </button>

    <% if (user) { %>
      <a href="/logout" class="btn btn-sm btn-ghost-danger nav-signout-btn" title="Sign out of operations console">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span>Sign Out</span>
      </a>
    <% } %>
  </div>
</header>
