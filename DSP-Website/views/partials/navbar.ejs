<header class="top-nav">
  <div class="nav-left">
    <button class="nav-mobile-toggle" id="mobileNavToggle" aria-label="Toggle navigation menu">&#9776;</button>

    <!-- Contextual SOC Telemetry & Breadcrumb (Replaces duplicate brand badge) -->
    <div class="soc-breadcrumbs" aria-label="Current security sector">
      <span class="soc-category">
        <% if (page === 'security-nodes') { %>GATEWAY TOOLS
        <% } else if (page === 'dashboard' || page === 'cam-view' || page === 'all-cams') { %>OPERATIONS CONSOLE
        <% } else if (page === 'map-view' || page === 'active-nodes-map') { %>CAMPUS GEOMETRY
        <% } else if (page === 'admin-users') { %>ADMINISTRATION
        <% } else { %>SYSTEM &amp; ACCOUNT<% } %>
      </span>
      <span class="soc-separator">/</span>
      <span class="soc-current-page">
        <% if (page === 'security-nodes') { %>SECURITY NODES
        <% } else if (page === 'dashboard') { %>DASHBOARD
        <% } else if (page === 'cam-view') { %>CAM VIEW
        <% } else if (page === 'all-cams') { %>ALL CAMS (CCTV)
        <% } else if (page === 'map-view') { %>CAMPUS MAP
        <% } else if (page === 'active-nodes-map') { %>ACTIVE THREATS MAP
        <% } else if (page === 'admin-users') { %>USER MANAGEMENT
        <% } else if (page === 'profile') { %>PROFILE
        <% } else if (page === 'settings') { %>SETTINGS
        <% } else { %>OPERATIONS<% } %>
      </span>
    </div>

    <div class="system-status-indicator">
      <div class="pulse-dot-green"></div>
      <span>SOC LIVE</span>
    </div>
  </div>

  <div class="nav-right">
    <div class="soc-live-clock font-mono" id="liveClock" title="SOC System Time">
      --:--:--
    </div>

    <!-- Quick Alarm Test / Toggle -->
    <button class="btn btn-sm btn-outline" id="quickAlarmToggleBtn" title="Test Alert Siren" onclick="if(window.alarmSound) window.alarmSound.playAlarm(2000);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
      </svg>
      <span>Audio Siren</span>
    </button>

    <% if (user) { %>
      <div class="user-snippet" style="margin-left: 8px;">
        <div class="user-avatar">
          <%= user.name ? user.name.charAt(0).toUpperCase() : 'O' %>
        </div>
        <div class="user-info-text" style="display: none; @media(min-width: 600px){display: block;}">
          <div class="user-name"><%= user.name %></div>
          <div class="user-role"><%= user.role %></div>
        </div>
      </div>
      <a href="/logout" class="btn btn-sm btn-outline" style="color: #f87171; border-color: rgba(239, 68, 68, 0.3);">
        Sign Out
      </a>
    <% } %>
  </div>
</header>
