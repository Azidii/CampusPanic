<div class="form-group">
  <label class="form-label" for="<%= prefix %>Name">Node Name</label>
  <input class="form-input" id="<%= prefix %>Name" name="name" required maxlength="100" placeholder="e.g. West Perimeter Gate">
</div>

<div class="form-group">
  <label class="form-label" for="<%= prefix %>Building">Building</label>
  <select class="form-input" id="<%= prefix %>Building" name="building" required aria-describedby="<%= prefix %>LocationHelp">
    <option value="">Choose a building</option>
  </select>
</div>

<div class="form-group">
  <label class="form-label" for="<%= prefix %>Floor">Floor</label>
  <select class="form-input" id="<%= prefix %>Floor" name="floor" required disabled aria-describedby="<%= prefix %>LocationHelp">
    <option value="">Choose a building first</option>
  </select>
</div>

<div class="form-group">
  <label class="form-label" for="<%= prefix %>Room">Room / Location</label>
  <select class="form-input" id="<%= prefix %>Room" name="room" required disabled aria-describedby="<%= prefix %>LocationHelp">
    <option value="">Choose a floor first</option>
  </select>
</div>
<p class="nodes-hint" id="<%= prefix %>LocationHelp" data-location-help role="status">Select a building, then a floor, then a room.</p>
