  <!-- Leaflet Map JS (for maps) -->
  <% if (page === 'map-view' || page === 'active-nodes-map') { %>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <% } %>

  <!-- Core Common JavaScript -->
  <script src="/js/common.js"></script>
  <script src="/js/camera-hud.js"></script>
  <% if (user && page !== "notifications") { %><script src="/js/notifications.js"></script><% } %>

  <% if (['all-cams', 'security-nodes', 'cam-view'].includes(page)) { %>
    <script src="/js/nodes-ui.js"></script>
  <% } %>
  <!-- Dedicated Page-Specific JavaScript -->
  <% if (page) { %>
    <script src="/js/<%= page %>.js"></script>
  <% } %>
</body>
</html>
