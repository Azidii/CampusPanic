<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'CampusPanic — Security Operations Center' %></title>
  <meta name="description" content="CampusPanic is a real-time campus emergency operations center integrating acoustic detection, computer vision firearm verification, node status telemetry, and interactive maps.">
  <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">

  <!-- Leaflet Map Styles (if map view) -->
  <% if (page === 'active-nodes-map') { %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <% } %>

  <!-- Core Common Design System CSS -->
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/camera-hud.css">
  <link rel="stylesheet" href="/css/notifications.css">

  <% if (['all-cams', 'security-nodes', 'cam-view'].includes(page)) { %>
    <link rel="stylesheet" href="/css/security-nodes.css">
  <% } %>
  <!-- Dedicated Page-Specific CSS -->
  <% if (page) { %>
    <link rel="stylesheet" href="/css/<%= page === 'error' ? '404' : page %>.css">
  <% } %>
</head>
<body class="page-<%= page %>">

<% if (page !== 'login') { %><a class="skip-link" href="#<%= page === 'security-nodes' ? 'securityNodePage' : page === 'cam-view' ? 'singleNodePage' : page === 'all-cams' ? 'cctvPage' : 'mainContent' %>">Skip to content</a><% } %>
