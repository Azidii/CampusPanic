<%- include('partials/head') %>
<div class="app-container">
  <%- include('partials/sidebar') %>
  <div class="main-content">
    <%- include('partials/navbar') %>
    <main class="page-body" id="securityNodePage" data-admin="<%= user.role === 'admin' %>">
      <!-- 1. Page Header with Right-Aligned CCTV CTA -->
      <div class="nodes-heading">
        <div>
          <h1>Devices</h1>
          <p>Add a location, then connect its phone camera and ESP32 button box.</p>
        </div>
        <div class="node-action-row">
          <a href="/public/downloads/camera.apk" class="btn btn-outline" download="CampusPanicCamera-debug.apk">Download Android app</a>
          <a href="/cameras" class="btn btn-outline" id="openCctvBtn">View cameras &rarr;</a>
        </div>
      </div>

      <!-- Setup steps -->
      <ol class="setup-steps" aria-label="How to connect a device">
        <li><strong>Add a location</strong><span>Name, building and room. Use the form on the right.</span></li>
        <li><strong>Connect the phone camera</strong><span>Enter the 8-digit code in the Campus Panic Camera app.</span></li>
        <li><strong>Connect the ESP32</strong><span>Open the location below, then <em>Audio · ESP32 → Scan</em> and enter the PIN shown on the board.</span></li>
      </ol>

      <!-- 2. Full-Width Configuration / Model Warning Banner -->
      <div id="receiverStatus" class="receiver-status" role="status">Checking model service…</div>

      <!-- 3. Asymmetric Split Workspace (Large Viewport + Create Panel) -->
      <div class="nodes-setup-layout">
        <!-- Left Column: Camera Viewport + Registered Nodes List -->
        <section class="nodes-left-workspace">
          <div class="node-viewport setup-preview" id="setupPreview">
            <img hidden alt="Selected node live video">
            <div class="viewport-reticle" aria-hidden="true"></div>
            <div class="viewport-signal-tag font-mono">SIGNAL: OFFLINE // NO FEED</div>
            <div class="node-idle">
              <span class="camera-symbol">◉</span>
              <strong>Camera is currently inactive</strong>
              <span>Select an active node or launch the Campus Panic Camera app to establish stream.</span>
            </div>
            <span class="node-muted">🔇 AUDIO NOT CONFIGURED</span>
          </div>

          <div class="nodes-section-heading">
            <h2>Your locations</h2>
            <span id="nodeCount">0 nodes</span>
          </div>
          <div id="setupNodeList" class="setup-node-list">
            <p class="nodes-hint">Loading nodes…</p>
          </div>
        </section>

        <!-- Right Column: Create Security Node Form Card -->
        <section class="card node-create-panel">
          <h2>Add a location</h2>
          <p class="nodes-hint">Enter the location once. Camera and ESP32 are connected afterwards.</p>
          
          <% if (user.role === 'admin') { %>
            <form id="createNodeForm" class="node-form" autocomplete="off">
              <%- include('partials/node-fields', { prefix: 'create' }) %>
              <button class="btn btn-primary node-submit-btn" type="submit">
                Add location &amp; get pairing code
              </button>
              <p id="createNodeError" class="node-error" role="alert"></p>
            </form>
          <% } else { %>
            <p class="nodes-hint">An administrator can create and manage security nodes. You can view their connected feeds.</p>
          <% } %>

          <!-- Intentional Hardware Slot Status Module -->
          <div class="node-audio-space">
            <strong>
              <span class="slot-badge">ESP32</span>
              <span>Connect after adding a location</span>
            </strong>
            <span class="slot-status">Click a location in the list</span>
          </div>
        </section>
      </div>

      <%- include('partials/node-dialog') %>
    </main>
    <%- include('partials/footer') %>
  </div>
</div>
<%- include('partials/scripts') %>
