<%- include('partials/head') %>
<div class="app-container">
  <%- include('partials/sidebar') %>
  <div class="main-content">
    <%- include('partials/navbar') %>
    <main class="page-body" id="singleNodePage" data-node-id="<%= selectedNode ? selectedNode.nodeId : '' %>">
      <div class="nodes-heading"><div><p class="nodes-eyebrow">CAMERA &amp; INCIDENT REVIEW</p><h1>Camera Feed &amp; Threat Verification</h1><p>Live detection results come directly from the laptop model.</p></div><a href="/cameras" class="btn btn-outline">All Cameras →</a></div>
      <div id="receiverStatus" class="receiver-status" role="status">Checking model service…</div>
      <div class="nodes-setup-layout"><section>
        <div class="node-viewport setup-preview" id="singlePreview"><img hidden alt="Live node model output"><div class="node-idle"><span class="camera-symbol">◉</span><strong>Camera is currently inactive</strong><span>Select a node or connect its phone.</span></div><span class="node-muted">🔇 Audio not configured</span></div>
        <dl id="singleLiveDetails" class="node-live-details"></dl>
        <% if (selectedNode) { %><button type="button" class="btn btn-outline" id="manageSelectedNode">Enlarge / Manage Node</button><% } %>
      </section><section class="card node-create-panel"><h2>Security node</h2><label class="form-label" for="camNodeSelector">Choose a feed</label><select class="form-select" id="camNodeSelector"><option value="">Select a node</option><% nodes.forEach(function(n) { %><option value="<%= n.nodeId %>" <%= selectedNode && selectedNode.nodeId === n.nodeId ? 'selected' : '' %>><%= n.name || n.nodeId %> — <%= n.building %>, <%= n.room %></option><% }); %></select>
        <% if (selectedAlert) { %><div class="node-connection-controls"><h3>Recorded incident</h3><p><%= selectedAlert.emergencyType %> · <%= selectedAlert.threatStatus.replace(/_/g, ' ') %></p><p class="nodes-hint"><%= new Date(selectedAlert.timestamp).toLocaleString() %> · <%= selectedAlert.building %>, <%= selectedAlert.room %></p>
          <% if (selectedAlert.imageUrl) { %><img class="incident-snapshot" src="<%= selectedAlert.imageUrl %>" alt="Recorded incident snapshot"><% } %>
          <p>Vision confidence: <%= selectedAlert.firearmConfidence == null ? 'Unavailable' : Math.round(selectedAlert.firearmConfidence * 100) + '%' %></p><p>Audio confidence: <%= selectedAlert.audioConfidence == null ? 'Unavailable' : Math.round(selectedAlert.audioConfidence * 100) + '%' %></p>
        </div><% } %>
        <div class="node-connection-controls"><h3>Incident snapshots</h3><% latestAlerts.forEach(function(item) { %><a class="incident-link" href="/cam-view?alertId=<%= item._id %>"><%= item.room %> · <%= new Date(item.timestamp).toLocaleString() %></a><% }); %><% if (!latestAlerts.length) { %><p class="nodes-hint">No saved incident snapshots.</p><% } %></div>
      </section></div>
      <%- include('partials/node-dialog') %>
    </main>
    <%- include('partials/footer') %>
  </div>
</div>
<%- include('partials/scripts') %>
