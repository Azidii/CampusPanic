<%- include('partials/head') %>
<div class="app-container">
  <%- include('partials/sidebar') %>
  <div class="main-content">
    <%- include('partials/navbar') %>
    <main class="page-body page-body-dashboard" tabindex="-1" id="mainContent">
      <div class="feed-heading dashboard-heading"><div><h1>Dashboard</h1><p>Campus incidents, live signals, and response activity.</p></div><p id="dashboardConnection" class="dashboard-connection" role="status">Updating incident reports…</p></div>
      <p id="outsideIncidents"><%= feed.outsideOpen %> open incidents outside this building selection. <a href="/notifications">Campus-wide notifications →</a></p>
      <section class="stats-grid" aria-label="Incident totals in the selected building, including resolved and cleared incidents">
        <% for (const [type, label] of [['gunshot','Gunshot'],['medical','Medical'],['fire','Fire']]) { %>
          <div class="stat-pod pod-<%= type %>"><span class="stat-label"><%= label %></span><span class="stat-period">All time</span><span class="stat-value" id="count-<%= type %>"><%= counts[type] %></span></div>
        <% } %>
        <div class="stat-pod pod-nodes"><span class="stat-label">Connected nodes</span><span class="stat-period">Live coverage</span><span class="stat-value" id="count-active-nodes"><%= activeNodesCount %> / <%= totalNodes %></span></div>
      </section>
      <div id="dashboardThreat" aria-live="polite"></div>
      <details id="incidentFilters" class="dashboard-filter-panel" open><summary>Filter incidents</summary>
      <section class="dashboard-toolbar" aria-label="Incident filters">
        <%- include('partials/building-filter') %>
        <div class="feed-filter"><label for="incidentType">Incident type</label><select id="incidentType" class="form-input"><option value="all">All types</option><option value="gunshot">Gunshot</option><option value="medical">Medical</option><option value="fire">Fire</option><option value="panic">Panic</option></select></div>
        <div class="feed-filter"><label for="incidentStatus">Open status</label><select id="incidentStatus" class="form-input"><option value="all">All open</option><option value="new">New</option><option value="acknowledged">Acknowledged</option></select></div>
        <div class="feed-filter feed-search"><label for="alertSearchInput">Search incidents</label><input id="alertSearchInput" class="form-input" maxlength="100" placeholder="Room, building, node or operator"></div>
      </section>
      </details>
      <section aria-labelledby="openIncidentTitle"><div class="feed-heading"><h2 id="openIncidentTitle">Open incidents</h2><span id="openIncidentCount"><%= alerts.length %> matching</span></div>
        <div class="alert-feed-list" id="alertFeedList"><% for (const a of alerts) { %><%- include('partials/incident-card', {a}) %><% } %></div>
        <div id="alertEmptyState" class="radar-empty-state" data-connected="<%= activeNodesCount %>" data-total="<%= totalNodes %>" <%= alerts.length ? 'hidden' : '' %>>
          <svg class="radar-display" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
            <circle class="radar-ground" cx="100" cy="100" r="94"/>
            <g class="radar-grid" fill="none"><circle cx="100" cy="100" r="88" stroke-dasharray="2 6"/><circle cx="100" cy="100" r="64"/><circle cx="100" cy="100" r="38"/><path d="M12 100h176M100 12v176"/></g>
            <g class="radar-sweep"><foreignObject x="12" y="12" width="176" height="176"><div xmlns="http://www.w3.org/1999/xhtml" class="radar-scan-gradient"></div></foreignObject><path d="M100 100V12" stroke="currentColor" stroke-width="2.5"/></g>
            <circle class="radar-center" cx="100" cy="100" r="6"/>
          </svg>
          <div class="radar-copy"><h3 id="radarTitle">No open incidents</h3><p id="radarDescription">No open incidents in this building selection.</p><p class="radar-connection"><span class="radar-status-dot" aria-hidden="true"></span><span id="radarConnection">Waiting for a live update</span></p></div>
        </div>
      </section>
      <details class="node-threat-panel"><summary>Device status in this building selection</summary><div id="nodeThreatRows"><p>Checking connected hardware…</p></div><a href="/security-nodes">Manage devices →</a></details>
      <section class="resolved-history" aria-labelledby="resolvedTitle">
        <div class="feed-heading"><h2 id="resolvedTitle">Resolved history</h2><div class="feed-actions"><label class="checkbox-label"><input type="checkbox" id="showCleared"> Show cleared</label><button class="btn btn-outline btn-sm" id="clearResolved">Clear resolved</button></div></div>
        <p>Clearing hides resolved incidents for your account only. History, notifications and incident links stay available.</p>
        <details id="historyDetails"><summary id="historySummary">Browse resolved incidents</summary>
        <div id="resolvedFeed" class="alert-feed-list"><% for (const a of feed.history) { %><%- include('partials/incident-card', {a}) %><% } %></div>
        <p id="resolvedEmpty" class="feed-empty" <%= feed.history.length ? 'hidden' : '' %>>No resolved incidents match. Use Show cleared to include incidents you cleared.</p>
        <nav class="feed-pagination" aria-label="Resolved incident pages"><button class="btn btn-outline btn-sm" id="historyPrevious">Previous</button><span id="historyPage" role="status">Page <%= feed.historyPage %> of <%= feed.historyPages %> · <%= feed.historyTotal %> resolved incidents</span><button class="btn btn-outline btn-sm" id="historyNext">Next</button></nav>
        </details>
      </section>
      <script id="dashboardData" type="application/json"><%- JSON.stringify(feed).replace(/</g, '\\u003c') %></script>
    </main>
    <%- include('partials/footer') %>
  </div>
</div>
<%- include('partials/scripts') %>
