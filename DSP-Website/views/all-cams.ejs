<%- include('partials/head') %>
<div class="app-container">
  <%- include('partials/sidebar') %>
  <div class="main-content">
    <%- include('partials/navbar') %>
    <main class="page-body" id="cctvPage" data-admin="<%= user.role === 'admin' %>">
      <div class="nodes-heading"><div><p class="nodes-eyebrow">CAMPUS SURVEILLANCE</p><h1>CCTV Monitoring Room</h1><p>All security nodes in one view. Select a feed to enlarge it and manage its connection.</p></div><a class="btn btn-primary" href="/security-nodes">Create Security Nodes →</a></div>
      <div class="cctv-toolbar"><div class="node-filter-group" role="group" aria-label="Filter security nodes"><button class="filter-chip active" data-node-filter="all">All nodes</button><button class="filter-chip" data-node-filter="live">Live</button><button class="filter-chip" data-node-filter="offline">Offline</button></div><span id="cctvSummary" role="status">Checking connections…</span></div>
      <div id="receiverStatus" class="receiver-status" role="status">Checking model service…</div>
      <div id="cctvGrid" class="security-cctv-grid"></div>
      <div id="cctvEmpty" class="nodes-empty" hidden><span class="camera-symbol">◉</span><h2>No security nodes here yet</h2><p>Create a node, enter its pairing code on your phone, and its video will appear here.</p><a href="/security-nodes" class="btn btn-outline">Open Security Nodes</a></div>
      <%- include('partials/node-dialog') %>
    </main>
    <%- include('partials/footer') %>
  </div>
</div>
<%- include('partials/scripts') %>
