<%- include('partials/head') %>

<div class="app-container">
  <%- include('partials/sidebar') %>

  <div class="main-content">
    <%- include('partials/navbar') %>

    <main class="page-body" tabindex="-1" id="mainContent" tabindex="-1">
      <%- include('partials/tabs', { group: 'map' }) %>
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 14px;">
        <div>
          <h1>Active Threats Map <span class="threat-pill-badge">LIVE</span></h1>
          <p style="font-size: 0.85rem; color: var(--text-secondary);">Live gun/shooter detections, smoke/fire incidents and manual alerts reported by paired ESP32 nodes.</p>
        </div>

      </div>

      <%- include('partials/building-filter') %>
      <p id="mapLocationStatus" role="status"></p>
      <p id="threatLiveBanner" class="threat-live-banner" role="status" aria-live="polite">Monitoring active campus threats…</p>
      <div class="threat-map-layout">
        <!-- Main Map -->
        <div class="threat-map-wrapper">
          <div id="activeThreatMap"></div>
        </div>

        <!-- Sidebar Threat List -->
        <div class="threat-sidebar-list">
          <div class="card" style="padding: 14px; background: var(--threat-verified-bg); border-color: var(--threat-verified-border);">
            <div style="font-size: 0.82rem; font-weight:600; color: var(--threat-verified); text-transform:none; margin-bottom: 4px;">
              <span id="hotspotCount">Active Incident Hotspots: <%= activeNodes.length %></span>
            </div>
            <div style="font-size:0.8125rem; color: var(--text-muted);">
              Color-coded by emergency type with automated verification telemetry.
            </div>
          </div>

          <% if (activeAlerts && activeAlerts.length > 0) { %>
            <% activeAlerts.forEach(function(alert) { %>
              <div class="threat-hotspot-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                  <span class="badge badge-<%= alert.emergencyType %>"><%= alert.emergencyType %></span>
                  <span style="font-size:0.8125rem; color: var(--text-muted); font-family: var(--font-mono);">
                    <%= new Date(alert.timestamp).toLocaleTimeString() %>
                  </span>
                </div>
                <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-primary);"><%= alert.room %></div>
                <div style="font-size:0.8125rem; color: var(--text-secondary);"><%= alert.building %> (<%= alert.nodeId %>)</div>

                <% if (alert.imageUrl) { %>
                  <img class="threat-snapshot-thumb" src="<%= alert.imageUrl %>" alt="Alert snapshot">
                <% } %>

                <div style="margin-top: 10px; display: flex; justify-content: space-between; align-items: center;">
                  <span style="font-size:0.8125rem; font-family: var(--font-mono); color: <%= alert.threatStatus === 'verified_threat' ? 'var(--threat-verified)' : 'var(--threat-unverified)' %>;">
                    <%= alert.threatStatus.replace(/_/g, ' ') %>
                  </span>
                  <a href="/cam-view?nodeId=<%= alert.nodeId %>&alertId=<%= alert._id %>" class="btn btn-sm btn-danger">
                    Inspect Feed &rarr;
                  </a>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div style="text-align: center; padding: 40px 16px; color: var(--text-muted); font-size: 0.88rem;">
              No active emergency incidents currently reported.
            </div>
          <% } %>
        </div>
      </div>

      <!-- Injected Data Payload -->
      <script id="activeNodesData" type="application/json">
        <%- JSON.stringify({ activeNodes, activeAlerts }).replace(/</g, '\\u003c') %>
      </script>
    </main>

    <%- include('partials/footer') %>
  </div>
</div>

<%- include('partials/scripts') %>
